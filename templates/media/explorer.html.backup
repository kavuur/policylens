{% extends "media/base.html" %}

{% block media_content %}
<div class="explorer-container container-fluid p-0">
    <div class="row g-0 h-100">
        <!-- Sidebar -->
        <div class="col-md-3 explorer-sidebar border-end px-0">
            <div class="p-3">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-1 border-bottom-light">
                    <h6 class="mb-0 text-uppercase text-muted small fw-bolder">Workspaces</h6>
                    <a href="#" class="btn btn-xs btn-primary-light" data-bs-toggle="modal"
                        data-bs-target="#newProjectModal" title="New Project">
                        <i class="fas fa-plus fa-sm"></i>
                    </a>
                </div>
                <div class="list-group list-group-flush explorer-nav-list">
                    <a href="{{ url_for('list_media') }}"
                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {% if not current_project_id %}active{% endif %}">
                        <span><i class="fas fa-inbox me-2"></i>All Files</span>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill">{{ all_media_count }}</span>
                    </a>
                    {% for project in projects %}
                    <a href="{{ url_for('list_media', project_id=project.id) }}"
                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {% if current_project_id == project.id %}active{% endif %}">
                        <span><i class="fas fa-folder me-2"></i>{{ project.name }}</span>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill">{{ project.media_count
                            }}</span>
                    </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-md-9">
            <div class="p-4 h-100 d-flex flex-column">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <h4 class="mb-0 text-dark fw-bold file-view-title">
                        {% set current_project = projects|selectattr('id', 'equalto', current_project_id)|first %}
                        <i class="fas fa-{{ 'folder-open' if current_project_id else 'inbox' }} me-2 text-primary"></i>
                        {{ current_project.name if current_project else 'All Files' }}
                    </h4>
                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm search-box" style="width: 250px;">
                            <span class="input-group-text bg-light border-end-0"><i
                                    class="fas fa-search text-muted"></i></span>
                            <input type="text" id="searchInput" class="form-control border-start-0 ps-0 bg-light"
                                placeholder="Search files..." value="{{ search_query }}">
                            <button class="btn btn-outline-secondary border-start-0 bg-light" type="button"
                                id="clearSearch" title="Clear Search" style="border-color: #ced4da;">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <a href="{{ url_for('upload_media') }}" class="btn btn-primary btn-sm px-3 shadow-sm">
                            <i class="fas fa-cloud-upload-alt me-2"></i>Upload
                        </a>
                    </div>
                </div>

                <!-- Files Grid -->
                <div class="files-list flex-grow-1">
                    {% if media_items %}
                    <div class="table-responsive" id="mediaGrid">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%;">File Name</th>
                                    <th style="width: 20%;">Owner</th>
                                    <th style="width: 20%;">Date Uploaded</th>
                                    <th style="width: 20%;" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for media in media_items %}
                                <tr class="media-item" data-filename="{{ media.filename|lower }}">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="me-3 text-center" style="width: 40px;">
                                                {% if media.file_type and media.file_type.startswith('image/') %}
                                                <img src="{{ url_for('uploaded_file', filename=media.filename) }}"
                                                    alt="icon" class="rounded"
                                                    style="width: 32px; height: 32px; object-fit: cover;">
                                                {% else %}
                                                {% set icon_class = 'fa-file' %}
                                                {% set icon_color = 'text-secondary' %}
                                                {% if media.file_type %}
                                                {% if 'pdf' in media.file_type %}{% set icon_class = 'fa-file-pdf' %}{%
                                                set icon_color = 'text-danger' %}
                                                {% elif 'word' in media.file_type %}{% set icon_class = 'fa-file-word'
                                                %}{% set icon_color = 'text-primary' %}
                                                {% elif 'excel' in media.file_type or 'sheet' in media.file_type %}{%
                                                set icon_class = 'fa-file-excel' %}{% set icon_color = 'text-success' %}
                                                {% elif 'video' in media.file_type %}{% set icon_class = 'fa-file-video'
                                                %}{% set icon_color = 'text-info' %}
                                                {% elif 'audio' in media.file_type %}{% set icon_class = 'fa-file-audio'
                                                %}{% set icon_color = 'text-warning' %}
                                                {% endif %}
                                                {% endif %}
                                                <i class="fas {{ icon_class }} fa-lg {{ icon_color }}"></i>
                                                {% endif %}
                                            </div>
                                            <div>
                                                <a href="{{ url_for('view_media', media_id=media.id) }}"
                                                    class="text-decoration-none text-dark fw-medium text-break">{{
                                                    media.filename }}</a>
                                                <div class="small text-muted">{{ (media.file_size / 1024)|round(1) }} KB
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2"
                                                style="width: 28px; height: 28px;">
                                                <i class="fas fa-user fa-xs text-secondary"></i>
                                            </div>
                                            <span class="text-muted">{{ media.user.name or media.user.username }}</span>
                                        </div>
                                    </td>
                                    <td class="text-muted">
                                        {{ media.uploaded_at.strftime('%Y-%m-%d') }}
                                        <small class="d-block text-muted" style="font-size: 0.75em;">{{
                                            media.uploaded_at.strftime('%H:%M') }}</small>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a href="{{ url_for('view_media', media_id=media.id) }}"
                                                class="btn btn-sm btn-outline-secondary" title="View">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ url_for('edit_media', media_id=media.id) }}"
                                                class="btn btn-sm btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="{{ url_for('download_media', media_id=media.id) }}"
                                                class="btn btn-sm btn-outline-secondary" title="Download">
                                                <i class="fas fa-download"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-danger delete-media"
                                                data-id="{{ media.id }}" data-filename="{{ media.filename }}"
                                                title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="alert alert-warning no-results py-3 text-center shadow-sm" style="display: none;">
                        <i class="fas fa-search me-2"></i> No files match your search.
                    </div>
                    {% else %}
                    <div
                        class="text-center py-5 rounded-3 bg-light-subtle h-100 d-flex flex-column justify-content-center align-items-center">
                        <div class="mb-3 p-4 bg-white rounded-circle shadow-sm">
                            <i class="fas fa-cloud-upload-alt fa-3x text-primary opacity-50"></i>
                        </div>
                        <h5 class="fw-bold text-dark">No files yet</h5>
                        <p class="text-muted mb-4">Upload documents, images, or media to get started.</p>
                        <a href="{{ url_for('upload_media') }}" class="btn btn-primary px-4">
                            <i class="fas fa-plus me-2"></i>Upload File
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- New Project Modal -->
<div class="modal fade" id="newProjectModal" tabindex="-1" aria-labelledby="newProjectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light py-2 border-bottom-0">
                <h6 class="modal-title fw-bold" id="newProjectModalLabel">Create New Project</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ url_for('create_project') }}" method="POST">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="projectName" class="form-label fw-medium small text-muted">PROJECT NAME</label>
                        <input type="text" class="form-control" id="projectName" name="name" required
                            placeholder="My Awesome Project">
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="mb-3 text-danger">
                    <i class="fas fa-exclamation-circle fa-3x"></i>
                </div>
                <h5 class="mb-2 fw-bold">Delete File?</h5>
                <p class="text-muted small mb-4">Are you sure you want to delete <strong id="deleteFilenamePlaceholder"
                        class="text-dark"></strong>? This action cannot be undone.</p>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-danger" id="confirmDelete">Yes, Delete it</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block styles %}
{{ super() }}
<style>
    /* --- Custom Utilities --- */
    .explorer-container {
        height: calc(100vh - 100px);
        background-color: #f8f9fa;
    }

    /* --- Sidebar --- */
    .explorer-sidebar {
        background: white;
        height: 100%;
        overflow-y: auto;
    }

    .explorer-nav-list .list-group-item {
        border: none;
        padding: 0.75rem 1rem;
        margin-bottom: 0.25rem;
        border-radius: 0.5rem;
        color: #495057;
        font-weight: 500;
        transition: all 0.2s;
    }

    .explorer-nav-list .list-group-item:hover {
        background-color: #e9ecef;
        color: #212529;
    }

    .explorer-nav-list .list-group-item.active {
        background-color: #e7f1ff;
        color: #0d6efd;
        font-weight: 600;
    }

    .explorer-nav-list .list-group-item.active .badge {
        background-color: #0d6efd !important;
        color: white !important;
    }
</style>
{% endblock %}

{% block scripts %}
{{ super() }}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Search Functionality
        const searchInput = document.getElementById('searchInput');
        const clearSearch = document.getElementById('clearSearch');
        const mediaGrid = document.getElementById('mediaGrid');
        const noResults = document.querySelector('.no-results');

        function filterMedia() {
            const searchTerm = searchInput.value.toLowerCase();
            const items = document.querySelectorAll('.media-item');
            let hasVisible = false;

            items.forEach(item => {
                const filename = item.dataset.filename;
                if (filename.includes(searchTerm)) {
                    item.style.display = '';
                    hasVisible = true;
                } else {
                    item.style.display = 'none';
                }
            });

            if (noResults) {
                noResults.style.display = hasVisible ? 'none' : 'block';
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', filterMedia);
            clearSearch.addEventListener('click', () => {
                searchInput.value = '';
                filterMedia();
            });
        }

        // Delete Functionality
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        let deleteId = null;

        document.querySelectorAll('.delete-media').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault(); // Prevent navigation if wrapped in <a>
                deleteId = this.dataset.id;
                document.getElementById('deleteFilenamePlaceholder').textContent = this.dataset.filename;
                deleteModal.show();
            });
        });

        document.getElementById('confirmDelete').addEventListener('click', function () {
            if (!deleteId) return;

            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Deleting...';

            fetch(`/media/delete/${deleteId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': '{{ csrf_token() }}'
                }
            })
                .then(response => {
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Failed to delete file.');
                        btn.disabled = false;
                        btn.textContent = 'Yes, Delete it';
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Error deleting file.');
                    btn.disabled = false;
                    btn.textContent = 'Yes, Delete it';
                });
        });
    });
</script>
{% endblock %}